# Copy to .env locally. Never commit a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APG_LIVE_OPT_IN=0
APG_DATA_DIR=.runtime
APG_MAX_CALLS=12
APG_MAX_OUTPUT_TOKENS=700
APG_MAX_RETRIES=1
APG_MAX_SECONDS=90
APG_MAX_SPEND_USD=0.15
APG_EVAL_SPEND_USD=3.00
# Conservative operator-supplied estimates per million tokens, not quoted provider prices.
APG_INPUT_PRICE=5
APG_OUTPUT_PRICE=20
